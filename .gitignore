# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Private notes and dev todos
notes/
kktodo*.md
mycelium/

# Runtime files — personal data, not for repo
ratings_log.json
somnivex.log

# Media — too large for git
*.mp4
*.avi
*.mkv
*.webm
media/
*.png
*.jpg
*.jpeg

# Demo video — keep this one
!videos/demos/somnivex-demo.mp4

# Screenshots — keep these
!screenshots/*.png

# Gallery saved pieces (user-specific)
gallery/pieces/

# NCA checkpoints — large binary files, stored separately
nca/checkpoints/*.pkl
# Keep the classifier — it's a project artifact, not a runtime output
!nca/state_classifier.pkl

# Runtime logs and saves — generated per-run, not for repo
nca/logs/
nca/saves/

# JAX / XLA cache
.jax_cache/
/tmp/

# Environment
.env
*.env
ai-env/

# IDE
.vscode/
.idea/
*.swp
*~
videos/

# Claude Code local config
.claude/
